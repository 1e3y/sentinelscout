# Railway → API service variables (placeholders only — never commit real secrets)
ENVIRONMENT=staging
DATABASE_URL=${{Postgres.DATABASE_URL}}
CLERK_ISSUER=https://YOUR_STAGING_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_STAGING_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_AUTHORIZED_PARTIES=https://YOUR_VERCEL_STAGING_URL
FRONTEND_URL=https://YOUR_VERCEL_STAGING_URL
CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_STAGING_URL
LOG_LEVEL=INFO
SCOUT_MAX_DISCOVERED_ASSETS=200
SCOUT_HTTP_TIMEOUT=120
SCOUT_SUBFINDER_TIMEOUT=180
WORKER_POLL_INTERVAL=1
SCHEDULER_POLL_INTERVAL=5
RATE_LIMIT_ENABLED=true

# Freeze-time email snapshots (set before enabling org email). Do not create a real Resend key yet.
EMAIL_FROM=
EMAIL_PROVIDER=fake
EMAIL_DELIVERY_ENABLED=false

