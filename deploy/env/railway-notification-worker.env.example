# Railway → notification worker (placeholders only — never commit real secrets)
# Start: /app/.venv/bin/python -m app.notification_worker
# EMAIL_DELIVERY_ENABLED=false pauses claiming; pending rows stay pending.
# Do not create a real Resend API key yet.

ENVIRONMENT=staging
DATABASE_URL=${{Postgres.DATABASE_URL}}
CLERK_ISSUER=https://YOUR_STAGING_INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=https://YOUR_STAGING_INSTANCE.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_REPLACE_ME
CLERK_AUTHORIZED_PARTIES=https://YOUR_VERCEL_STAGING_URL
FRONTEND_URL=https://YOUR_VERCEL_STAGING_URL
CORS_ALLOWED_ORIGINS=https://YOUR_VERCEL_STAGING_URL
LOG_LEVEL=INFO
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=resend
EMAIL_FROM=
EMAIL_API_KEY=
EMAIL_STAGING_ALLOWLIST=
NOTIFICATION_WORKER_POLL_INTERVAL=2
NOTIFICATION_LEASE_SECONDS=300
NOTIFICATION_PROVIDER_TIMEOUT_SECONDS=15

# AES-256-GCM key for transient automatic-report share secrets (64 hex chars).
# Generate with: openssl rand -hex 32
# Never commit the real value. Main API /ready does not require this key.
REPORT_DELIVERY_SECRET_KEY=
REPORT_DELIVERY_SECRET_KEY_VERSION=v1
