ENVIRONMENT=development

# PostgreSQL (matches docker-compose.yml for local only)
DATABASE_URL=postgresql+psycopg://scout:scout@localhost:5432/scout

# Clerk (backend)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_SECRET_KEY=sk_test_...
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# API / frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# API_CORS_ORIGINS remains accepted as an alias for CORS_ALLOWED_ORIGINS

LOG_LEVEL=INFO
WORKER_POLL_INTERVAL=1
SCHEDULER_POLL_INTERVAL=5

SCOUT_MAX_DISCOVERED_ASSETS=500
SCOUT_HTTP_TIMEOUT=120
SCOUT_SUBFINDER_TIMEOUT=180

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800

RATE_LIMIT_ENABLED=true
RATE_LIMIT_TARGET_CREATE=20
RATE_LIMIT_VERIFICATION=30
RATE_LIMIT_OPERATION_CREATE=30
RATE_LIMIT_VALIDATION=60
RATE_LIMIT_RETEST=30
RATE_LIMIT_WINDOW_SECONDS=3600

# Clerk (frontend — apps/web/.env.local)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
